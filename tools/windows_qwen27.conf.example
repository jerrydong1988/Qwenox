# Copy to service.conf in a separate deployment with the updated gdec-win.exe.
# Native start_win.exe works unchanged. Replace MODEL_DIR with your local folder.
MODEL_DIR="./models/halogen-qwen3.8-27b"
MODEL_FILE="$MODEL_DIR/qwen3.8-27b-p1w4d-d2.hgn"
TOKENIZER_DIR="$MODEL_DIR/tokenizer"
NGRAM_FILE="$MODEL_FILE"
MTP_FILE=""
VISION_FILE=""
OVERLAY_FILE=""
ENGINE_HOST="127.0.0.1"
API_HOST="127.0.0.1"
ENGINE_PORT="18870"
API_PORT="18871"
API_MODEL="qwen3.8-27b-hgn"
MAX_CONTEXT="8192"
PARALLEL="1"
GDEC_DRAFTER="mtp"
GDEC_QWEN27_MTP="1"
GDEC_QWEN27_MTP_GAMMA="3"
# Optional DFlash2 uses the full vocabulary and takes precedence over MTP.
GDEC_QWEN27_DFLASH="0"
GDEC_QWEN27_DFLASH_GAMMA="4"
GDEC_QWEN27_PREFILL_MODE="compensated"
MTP_GAMMA="0"
KVSNAP_MAX_GB="0"
RCKPT_MAX="0"
GDEC_RETRY_CHECKPOINT="0"
GDEC_CKPT_TOKENS="0"
# This backend allocates a dense FP32 KV cache and uses 512-token prefill chunks.
KV_PAGED="0"
KV_POOL_TOKENS="0"
PREFILL_CHUNK="512"
